# Copy to .env and fill in. Never commit .env.
# --- Website ---
ADMIN_PASSWORD=
COMPANY=NEWBILLION Precision Metal Sdn Bhd
PUBLIC_URL=https://smm.example.com
SECURE_COOKIES=1
# --- Database (docker-compose sets DATABASE_URL for its own PostgreSQL) ---
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://user:pass@host:5432/smm
# --- Backups ---
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MONTHS=120
# BACKUP_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# BACKUP_STORAGE=s3
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# --- Google BigQuery (reporting copy) ---
# BIGQUERY_PROJECT=
# BIGQUERY_DATASET=smm
# BIGQUERY_LOCATION=asia-southeast1
# GOOGLE_APPLICATION_CREDENTIALS=/data/bigquery-key.json
# BIGQUERY_EVERY_HOURS=24
